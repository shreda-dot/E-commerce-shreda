# ── PayPal ────────────────────────────────────────────────────────────────────
# Only the CLIENT ID goes here (it's public — never put the secret in the frontend).
# Using "test" lets you see real PayPal sandbox buttons with no credentials.
# Replace with your actual Sandbox Client ID from developer.paypal.com when ready.
VITE_PAYPAL_CLIENT_ID=test
